# Makefile.ulp — Build and run the Verilator ULP tolerance harness
#
# Usage:
#   make -f test/Makefile.ulp          # build and run from repo root
#   ./obj_dir/Vtt_um_joram200          # re-run without rebuild
#
# Requires: verilator (>= 4.200), g++/clang++

SRC_DIR   := src
TEST_DIR  := test
OBJ_DIR   := obj_dir
TOP       := tt_um_joram200

# Source files (in elaboration order)
RTL_SRCS  := $(SRC_DIR)/compute_core.sv \
             $(SRC_DIR)/interface.sv     \
             $(SRC_DIR)/top.sv

.PHONY: all run clean

all: run

$(OBJ_DIR)/V$(TOP): $(RTL_SRCS) $(TEST_DIR)/ulp_check.cpp
	verilator \
	    --cc \
	    --exe \
	    --build \
	    --Mdir $(OBJ_DIR) \
	    -sv \
	    -Wall \
	    -Wno-UNUSED \
	    -Wno-UNDRIVEN \
	    -Wno-DECLFILENAME \
	    -I$(SRC_DIR) \
	    $(RTL_SRCS) \
	    $(TEST_DIR)/ulp_check.cpp \
	    --top-module $(TOP)

run: $(OBJ_DIR)/V$(TOP)
	./$(OBJ_DIR)/V$(TOP)

clean:
	rm -rf $(OBJ_DIR)
